#!/bin/bash
set -euo pipefail

# Apply monitor settings from a JSON array on stdin (or as $1), write
# ~/.config/hypr/monitors.lua (after backup), and apply live via hyprctl.
#
# Each entry: { "output": "eDP-2", "mode": "preferred"|"WxH@Hz", "position": "auto"|"XxY", "scale": "auto"|number }

MON_FILE="${HOME}/.config/hypr/monitors.lua"
json_input="${1-}"

if [[ -z $json_input ]]; then
  json_input=$(cat)
fi

[[ -n $json_input ]] || { echo "missing monitor JSON" >&2; exit 1; }

if ! printf '%s' "$json_input" | jq -e 'type == "array"' >/dev/null; then
  echo "monitor payload must be a JSON array" >&2
  exit 1
fi

mkdir -p "$(dirname "$MON_FILE")"
if [[ -f $MON_FILE ]]; then
  cp -a "$MON_FILE" "${MON_FILE}.bak.$(date +%s)"
fi

# Nearest whole number for GDK_SCALE from the highest numeric scale.
gdk_scale=$(printf '%s' "$json_input" | jq -r '
  [ .[] | .scale
    | if type == "number" then .
      elif . == "auto" then empty
      else (tonumber? // empty) end
  ] | if length == 0 then 1 else max | round | if . < 1 then 1 else . end end
')

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

{
  cat <<'HEADER'
-- See https://wiki.hypr.land/Configuring/Basics/Monitors/
-- List current monitors and supported resolutions with: hyprctl monitors all
--
-- Generated by the cesosag.settings Omarchy shell plugin. A backup of the
-- previous file is kept beside this one as monitors.lua.bak.<timestamp>.

HEADER

  # Catch-all default so newly attached displays get a sane config.
  printf 'local omarchy_monitor_scale = "auto"\n'
  printf 'hl.monitor({ output = "", mode = "preferred", position = "auto", scale = omarchy_monitor_scale })\n\n'

  printf '%s' "$json_input" | jq -r '
    def lua_scale:
      if . == "auto" then "\"auto\""
      elif type == "number" then tostring
      else (tonumber? // 1 | tostring) end;
    def lua_str: "\"" + gsub("\""; "\\\"") + "\"";
    .[] |
      "hl.monitor({ output = " + (.output | lua_str)
        + ", mode = " + (.mode // "preferred" | lua_str)
        + ", position = " + (.position // "auto" | lua_str)
        + ", scale = " + (.scale | lua_scale)
        + " })"
  '

  cat <<EOF

-- GDK scale is GDK_SCALE, the factor GTK draws its own UI at.
local omarchy_gdk_scale = ${gdk_scale}
hl.env("GDK_SCALE", tostring(omarchy_gdk_scale))
EOF
} >"$tmp"

mv "$tmp" "$MON_FILE"
trap - EXIT

# Live-apply each named output. Prefer preferred/auto forms Hyprland accepts.
while IFS=$'\t' read -r output mode position scale; do
  [[ -n $output ]] || continue
  hyprctl keyword monitor "${output},${mode},${position},${scale}" >/dev/null
done < <(printf '%s' "$json_input" | jq -r '.[] | [.output, (.mode // "preferred"), (.position // "auto"), (.scale | tostring)] | @tsv')

# Ask Hyprland to re-read sourced Lua so the written file stays the source of truth.
hyprctl reload >/dev/null || true

echo "monitors updated ($MON_FILE)"
